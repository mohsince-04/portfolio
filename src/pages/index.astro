---
import '../styles/global.css';
---

<html lang="en" class="catppuccin-macchiato bg-ctp-crust text-ctp-text selection:bg-ctp-surface1 selection:text-ctp-rosewater scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mohsin Nisar | Systems & AI Engineer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    
    <style>
      /* Pure Transparent Card Hover Glow */
      .glow-card {
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .glow-card:hover {
        box-shadow: 0 0 30px -5px rgba(138, 173, 244, 0.2), 0 0 10px -2px rgba(138, 173, 244, 0.08);
        transform: translateY(-3px);
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-fade-in {
        animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .delay-1 { animation-delay: 0.1s; opacity: 0; }
      .delay-2 { animation-delay: 0.25s; opacity: 0; }
      .delay-3 { animation-delay: 0.4s; opacity: 0; }
      .delay-4 { animation-delay: 0.55s; opacity: 0; }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }
      .animate-blink {
        animation: blink 1s infinite;
      }

      #mobile-menu {
        transform-origin: top right;
        transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease;
      }
      #mobile-menu.menu-hidden {
        opacity: 0;
        transform: scale(0.95) translateY(-8px);
        visibility: hidden;
        pointer-events: none;
      }
      #mobile-menu.menu-visible {
        opacity: 1;
        transform: scale(1) translateY(0);
        visibility: visible;
        pointer-events: auto;
      }
    </style>
  </head>
  
  <body class="font-sans antialiased min-h-screen flex flex-col justify-between p-6 md:p-12 max-w-5xl mx-auto selection:bg-ctp-blue selection:text-ctp-crust relative overflow-x-hidden">
    
    <!-- Background Ambient Video Backdrop -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none bg-[#11111b] transform-gpu">
      <div class="absolute inset-0 z-0 bg-[#11111b] opacity-75"></div>
      
      <video 
        id="bg-video"
        autoplay 
        loop 
        muted 
        playsinline 
        webkit-playsinline
        preload="auto"
        class="w-full h-full object-cover relative z-10 opacity-50 transform-gpu"
      >
        <source src="/assets/hero-bg.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Top Bar Navigation -->
    <header class="flex justify-between items-center border-b border-white/[0.08] pb-6 mb-12 animate-fade-in relative z-50">
      <div class="flex items-center gap-3">
        <span class="inline-block w-3 h-3 rounded-full bg-ctp-green animate-pulse"></span>
        <span class="font-mono text-xs text-ctp-subtext0 hidden sm:inline-block">~ $ <span class="text-ctp-text">whoami</span><span class="inline-block w-1.5 h-3.5 bg-ctp-blue animate-blink ml-1 align-middle"></span></span>
      </div>

      <div class="relative">
        <button id="menu-btn" class="text-ctp-text hover:text-ctp-blue p-2 flex items-center justify-center rounded-lg bg-transparent transition-colors cursor-pointer border-none outline-none shadow-none" aria-label="Toggle Menu">
          <svg id="menu-icon" class="w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path class="transition-all duration-300 origin-center" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16" id="line-1"></path>
            <path class="transition-opacity duration-200" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16" id="line-2"></path>
            <path class="transition-all duration-300 origin-center" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16" id="line-3"></path>
          </svg>
        </button>

        <!-- Slightly Opaque Frosted Glass Hamburger Menu Container -->
        <div id="mobile-menu" class="menu-hidden absolute top-full right-0 mt-3 w-56 bg-ctp-mantle/85 backdrop-blur-xl border border-white/[0.1] rounded-xl p-4 flex flex-col gap-3 font-mono text-xs shadow-2xl z-50">
          <a href="#projects" class="mobile-link text-ctp-overlay2 hover:text-ctp-mauve transition-colors py-1.5 border-b border-white/[0.06]">⚡ Featured Projects</a>
          <a href="https://github.com/mohsince-04?tab=repositories" class="mobile-link text-ctp-overlay2 hover:text-ctp-blue transition-colors py-1.5 border-b border-white/[0.06]" target="_blank" rel="noopener noreferrer">📂 Projects &#8599;</a> 
          <a href="https://github.com/mohsince-04" class="mobile-link text-ctp-overlay2 hover:text-ctp-peach transition-colors py-1.5 border-b border-white/[0.06]" target="_blank" rel="noopener noreferrer">💻 Github &#8599;</a>
          <a href="mailto:mohsince04@gmail.com" class="mobile-link text-ctp-overlay2 hover:text-ctp-green transition-colors py-1.5">📬 Contact &#8599;</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="space-y-16">
      
      <!-- Hero Section -->
      <section class="space-y-6">
        <div class="animate-fade-in delay-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-transparent border border-white/[0.08] font-mono text-xs text-ctp-sapphire">
            <span class="w-2 h-2 rounded-full bg-ctp-sapphire animate-pulse"></span>
            <span>⚡ Systems &amp; Generative AI Engineering</span>
          </div>
        </div>

        <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-ctp-text animate-fade-in delay-1">
          Mohsin Nisar
        </h1>        
        
        <div class="text-lg md:text-xl text-ctp-subtext0 max-w-3xl leading-relaxed space-y-4 animate-fade-in delay-1">
          <p>
            <i>
              An ambitious AI engineer dedicated to turning probabilistic, unpredictable language models into <span class="text-ctp-green font-semibold">deterministic, production-grade software infrastructure</span>.
            </i>
          </p>
        </div>
        
        <!-- Dream Goal Statement Container (Pure Transparent) -->
        <div class="p-6 rounded-xl bg-transparent border border-white/[0.08] space-y-3 glow-card animate-fade-in delay-2 group">
          <h2 class="font-mono text-sm uppercase tracking-wider text-ctp-peach font-semibold flex items-center gap-2">
            <span class="group-hover:rotate-12 transition-transform duration-300">🚀</span> My Dream Goal
          </h2>
          <p class="text-base md:text-lg text-ctp-subtext1 leading-relaxed">
            To spend the next 3–4 years building myself from absolute fundamentals to the level of a senior AI/ML Engineer and AI Systems Researcher — developing the depth to design, train, optimize, and deploy production-grade AI systems at scale.
          </p>
          <p class="text-sm text-ctp-overlay2 leading-relaxed">
            This is not a short-term goal or a race to learn tools. It is a long-term journey toward mastering the fundamentals, mathematics, algorithms, machine learning, deep learning, generative AI, systems engineering, research, and production infrastructure required to build serious AI systems from the ground up.
          </p>
        </div>

        <!-- Mission Statement -->
        <div class="text-lg md:text-xl text-ctp-subtext0 max-w-3xl leading-relaxed space-y-4 animate-fade-in delay-3"> 
          <p class="text-base text-ctp-overlay2">
            While I love building native automation workflows and experimental systems directly within my Linux environment, Currently, I am Intensely working on building <a href="https://github.com/mohsince-04/genai-50-projects" target="_blank" rel="noopener noreferrer" class="text-ctp-blue font-mono font-semibold hover:underline inline-flex items-center gap-1 group">genai-50-projects <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&#8599;</span></a>.
          </p>
        </div>

        <!-- Vision Focus Grid Containers (Pure Transparent) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 font-mono text-xs animate-fade-in delay-4">
          <div class="p-4 rounded-lg bg-transparent border border-white/[0.08] hover:border-ctp-mauve/50 hover:bg-white/[0.03] transition-all duration-300 hover:-translate-y-1">
            <span class="text-ctp-mauve block font-bold mb-1">01. Structured Outputs &amp; API Integration</span>
            <p class="text-ctp-subtext0 font-sans text-xs">Enforcing JSON schemas, system prompts, error handling, and API integration.</p>
          </div>
          <div class="p-4 rounded-lg bg-transparent border border-white/[0.08] hover:border-ctp-teal/50 hover:bg-white/[0.03] transition-all duration-300 hover:-translate-y-1">
            <span class="text-ctp-teal block font-bold mb-1">02. RAG &amp; Vector Retrieval</span>
            <p class="text-ctp-subtext0 font-sans text-xs">Vector databases, chunking strategies, embeddings, and semantic search.</p>
          </div>
          <div class="p-4 rounded-lg bg-transparent border border-white/[0.08] hover:border-ctp-peach/50 hover:bg-white/[0.03] transition-all duration-300 hover:-translate-y-1">
            <span class="text-ctp-teal block font-bold mb-1">03. Tool Calling &amp; Agent Utilities</span>
            <p class="text-ctp-subtext0 font-sans text-xs">Function execution, agent loops, external APIs, and safety constraints.</p>
          </div>
          <div class="p-4 rounded-lg bg-transparent border border-white/[0.08] hover:border-ctp-sapphire/50 hover:bg-white/[0.03] transition-all duration-300 hover:-translate-y-1">
            <span class="text-ctp-teal block font-bold mb-1">04. Multi-Agent &amp; State Graphs</span>
            <p class="text-ctp-subtext0 font-sans text-xs">LangGraph state machines, multi-role agent coordination, cyclic execution, and supervisor routing.</p>
          </div>
          <div class="p-4 rounded-lg bg-transparent border border-white/[0.08] hover:border-ctp-lavender/50 hover:bg-white/[0.03] transition-all duration-300 hover:-translate-y-1">
            <span class="text-ctp-teal block font-bold mb-1">05. Multimodal &amp; Real-Time Voice</span>
            <p class="text-ctp-subtext0 font-sans text-xs">Speech synthesis, audio transcription, vision LLMs, and real-time processing.</p>
          </div>
          <div class="p-4 rounded-lg bg-transparent border border-white/[0.08] hover:border-ctp-green/50 hover:bg-white/[0.03] transition-all duration-300 hover:-translate-y-1">
            <span class="text-ctp-teal block font-bold mb-1">06. Production Ops, Evals &amp; Scaling</span>
            <p class="text-ctp-subtext0 font-sans text-xs">Latency reduction, testing frameworks, observability, semantic caching, and security.</p>
          </div>
        </div>
      </section>

      <!-- Featured Projects Section Containers (Pure Transparent) -->
      <section id="projects" class="space-y-6 animate-fade-in delay-4 scroll-mt-10">
        <h2 class="font-mono text-xl text-ctp-mauve flex items-center gap-2">
          <span>#</span> Featured Projects
        </h2>

        <!-- Project Card 1 -->
        <div class="group relative rounded-xl border border-white/[0.08] bg-transparent p-6 md:p-8 transition-all hover:border-ctp-blue/50 glow-card cursor-pointer">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-2xl font-bold text-ctp-lavender group-hover:text-ctp-blue transition-colors">
                <a 
                  href="https://github.com/mohsince-04/genai-50-projects" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex items-center gap-2 after:absolute after:inset-0"
                >
                  genai-50-projects <span class="text-sm font-normal text-ctp-overlay1 font-mono group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">&#8599;</span>
                </a>
              </h3>
            </div>
          </div>
          <p class="text-ctp-subtext0 mb-6 text-sm md:text-base leading-relaxed">
            Systematic blueprint roadmap for building production-grade GenAI backends — featuring schema-enforced LLM agents, vectorized PyArrow analytics, and async LangGraph architectures.
          </p>
          <div class="flex flex-wrap gap-2 font-mono text-xs relative z-10">
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-yellow hover:scale-105 transition-transform">Pydantic</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-peach hover:scale-105 transition-transform">Sentence-Transformers</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-red hover:scale-105 transition-transform">Ollama</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-sapphire hover:scale-105 transition-transform">LangGraph</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-sapphire hover:scale-105 transition-transform">PyTorch</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-sapphire hover:scale-105 transition-transform">Redis</span>
          </div>
        </div>

        <!-- Project Card 2 -->
        <div class="group relative rounded-xl border border-white/[0.08] bg-transparent p-6 md:p-8 transition-all hover:border-ctp-blue/50 glow-card cursor-pointer">
          <div class="flex justify-between items-start mb-4">
            <div>
              <h3 class="text-2xl font-bold text-ctp-lavender group-hover:text-ctp-blue transition-colors">
                <a 
                  href="https://github.com/mohsince-04/rust-gemini-translator" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex items-center gap-2 after:absolute after:inset-0"
                >
                  rust-gemini-translator <span class="text-sm font-normal text-ctp-overlay1 font-mono group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">&#8599;</span>
                </a>
              </h3>
            </div>
          </div>
          <p class="text-ctp-subtext0 mb-6 text-sm md:text-base leading-relaxed">
            A rust based privacy-focused, self-hosted web translation pipeline that uses your personal Google Gemini account as a free translation backend.
          </p>
          <div class="flex flex-wrap gap-2 font-mono text-xs relative z-10">
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-yellow hover:scale-105 transition-transform">axum</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-peach hover:scale-105 transition-transform">tokio</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-red hover:scale-105 transition-transform">reqwest</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-sapphire hover:scale-105 transition-transform">serde &amp; serde_json</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-sapphire hover:scale-105 transition-transform">tower-http</span>
            <span class="px-2.5 py-1 rounded bg-transparent border border-white/[0.08] text-ctp-sapphire hover:scale-105 transition-transform">regex</span>
          </div>
        </div>

      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.08] mt-20 pt-8 flex flex-col md:flex-row justify-between items-center text-xs font-mono text-ctp-subtext0 gap-4 opacity-80 hover:opacity-100 transition-opacity">
      <div>
        <span>Built with Astro + Catppuccin Macchiato</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-ctp-mauve animate-pulse"></span>
        <span>OS: Arch Linux x86_64</span>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link');
      const line1 = document.getElementById('line-1');
      const line2 = document.getElementById('line-2');
      const line3 = document.getElementById('line-3');

      function toggleMenu() {
        const isOpen = mobileMenu?.classList.contains('menu-visible');
        if (isOpen) {
          mobileMenu?.classList.remove('menu-visible');
          mobileMenu?.classList.add('menu-hidden');
          line1?.setAttribute('d', 'M4 6h16');
          line1?.classList.remove('rotate-45', 'translate-y-[6px]');
          line2?.classList.remove('opacity-0');
          line3?.setAttribute('d', 'M4 18h16');
          line3?.classList.remove('-rotate-45', '-translate-y-[6px]');
        } else {
          mobileMenu?.classList.remove('menu-hidden');
          mobileMenu?.classList.add('menu-visible');
          line1?.setAttribute('d', 'M6 6l12 12');
          line1?.classList.add('rotate-45', 'translate-y-[6px]');
          line2?.classList.add('opacity-0');
          line3?.setAttribute('d', 'M6 18L18 6');
          line3?.classList.add('-rotate-45', '-translate-y-[6px]');
        }
      }

      menuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      document.addEventListener('click', (e) => {
        const target = e.target;
        if (target && !mobileMenu?.contains(target) && !menuBtn?.contains(target)) {
          if (mobileMenu?.classList.contains('menu-visible')) {
            toggleMenu();
          }
        }
      });

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          if (mobileMenu?.classList.contains('menu-visible')) {
            toggleMenu();
          }
        });
      });

      // Robust playback recovery for desktop and mobile browsers
      function checkAndPlayVideo() {
        const video = document.getElementById('bg-video');
        if (video) {
          if (video.paused) {
            video.play().catch(() => {});
          }
        }
      }

      window.addEventListener('DOMContentLoaded', checkAndPlayVideo);
      window.addEventListener('pageshow', checkAndPlayVideo);
      window.addEventListener('focus', checkAndPlayVideo);

      // Mobile autoplay policy fallback: instantly unlock and play on first touch/scroll interaction
      window.addEventListener('touchstart', checkAndPlayVideo, { once: true });
      window.addEventListener('scroll', checkAndPlayVideo, { once: true });
    </script>
  </body>
</html>
