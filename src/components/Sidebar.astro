<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('section[id]');

    // Click handler for pulse animation on target section
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        const targetId = link.getAttribute('href');
        if (!targetId || !targetId.startsWith('#')) return;
        const targetSection = document.querySelector(targetId);
        if (targetSection) {
          targetSection.classList.remove('animate-highlight');
          void (targetSection as HTMLElement).offsetWidth; // Force DOM reflow
          targetSection.classList.add('animate-highlight');
        }
      });
    });

    // Scroll Traversal Highlighting & Dynamic Indentation
    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -60% 0px', // Highlights when section crosses viewport threshold
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach((link) => {
            const href = link.getAttribute('href')?.replace('#', '');
            const dash = link.querySelector('.nav-dash');
            const text = link.querySelector('.nav-text');

            if (href === id) {
              // Active State: Indent right, highlight text & dash
              link.classList.add('translate-x-3', 'text-ctp-mauve');
              link.classList.remove('text-ctp-overlay2');
              if (dash) dash.classList.add('text-ctp-mauve');
              if (text) text.classList.add('font-bold');
            } else {
              // Inactive State: Reset
              link.classList.remove('translate-x-3', 'text-ctp-mauve');
              link.classList.add('text-ctp-overlay2');
              if (dash) dash.classList.remove('text-ctp-mauve');
              if (text) text.classList.remove('font-bold');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  });
</script>
